# ==========================================
# ChefBot Backend Environment Configuration
# ==========================================

# OpenRouter API Key for LLM queries (e.g. sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Default LLM model to use
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# Optional: Google Application Credentials for translation (if using GCP Service Account)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
